{
  "name": "picmaster-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,vue,json,css,scss,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,vue,json,css,scss,md}\"",
    "build:offline": "vue-tsc && vite build --base=./",
    "package": "node scripts/package-source.js"
  },
  "dependencies": {
    "axios": "^1.6.8",
    "element-plus": "^2.7.2",
    "fabric": "^5.3.0",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.3",
    "tailwindcss": "^4.1.18",
    "viewerjs": "^1.11.6",
    "vue": "^3.5.21",
    "vue-awesome-swiper": "^5.0.1",
    "vue-grid-layout": "^3.0.0-beta1",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/fabric": "^5.3.11",
    "@types/node": "^25.0.10",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/tsconfig": "^0.8.1",
    "archiver": "^7.0.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "sass": "^1.97.3",
    "swiper": "^8.0.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.1",
    "vite-plugin-singlefile": "^2.3.0",
    "vite-plugin-vue-devtools": "^8.0.5",
    "vue-tsc": "^3.2.2"
  }
}
